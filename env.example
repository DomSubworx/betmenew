# BetMe App Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================

# Your Supabase project URL (found in your Supabase dashboard)
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous/public key (found in your Supabase dashboard)
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# Your Supabase service role key (for admin operations - keep secret!)
REACT_APP_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# APP ENVIRONMENT
# =============================================================================

# Set to 'supabase' for production, 'demo' for local development
REACT_APP_ENVIRONMENT=demo

# Enable/disable Supabase integration
REACT_APP_USE_SUPABASE=false

# Enable/disable demo data fallback
REACT_APP_USE_DEMO_DATA=true

# Enable real-time features (requires Supabase)
REACT_APP_ENABLE_REALTIME=false

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Build configuration
GENERATE_SOURCEMAP=false

# Analytics (optional)
REACT_APP_GA_TRACKING_ID=

# =============================================================================
# SECURITY NOTES
# =============================================================================
# ⚠️  NEVER commit your .env file to version control
# ⚠️  Keep your service role key secret
# ⚠️  Only share the anon key publicly
# ⚠️  Use environment variables in production deployments
