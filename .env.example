# BetMe App Environment Configuration

# Environment Mode
# Options: 'demo' (default) or 'supabase'
REACT_APP_ENVIRONMENT=demo

# Feature Flags
# Enable Supabase integration (requires valid Supabase credentials)
REACT_APP_USE_SUPABASE=false

# Enable demo data (default: true)
REACT_APP_USE_DEMO_DATA=true

# Enable real-time subscriptions (Supabase mode only)
REACT_APP_ENABLE_REALTIME=false

# Supabase Configuration (required if REACT_APP_USE_SUPABASE=true)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Demo Mode Configuration
# Auto-save interval in milliseconds (default: 5000)
REACT_APP_DEMO_AUTO_SAVE_INTERVAL=5000

# Enable localStorage persistence (default: true)
REACT_APP_DEMO_PERSIST_TO_LOCALSTORAGE=true
